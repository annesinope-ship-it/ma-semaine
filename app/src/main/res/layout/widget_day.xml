<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fond arrondi (couleur choisie dans l'appli) -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <!-- En-tête : Lundi •      6   + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/day_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lora_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Lundi"
                    android:textColor="#7A4B4B"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/today_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp"
                    android:text="•"
                    android:textColor="#7A4B4B"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/day_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/worksans_regular"
                    android:paddingStart="8dp"
                    android:text="0"
                    android:textColor="#8A8A8A"
                    android:textSize="12sp" />

                <!-- Motif, à côté du nom du jour -->
                <ImageView
                    android:id="@+id/deco"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginStart="7dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/add_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:fontFamily="@font/worksans_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="+"
                android:textColor="#8A8A8A"
                android:textSize="21sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/task_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/empty_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/lora_italic"
                android:gravity="top|start"
                android:paddingTop="6dp"
                android:text="Rien de prévu"
                android:textColor="#8A8A8A"
                android:textSize="13sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
